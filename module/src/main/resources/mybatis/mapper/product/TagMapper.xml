<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.beat.mall.module.product.mapper.TagMapper">

    <!-- 插入数据 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id" parameterType="com.beat.mall.module.product.entity.Tag">
        INSERT INTO tag
        <trim prefix="(" suffix=")" suffixOverrides=",">
                    <if test="id != null">
                        id,
                    </if>
                    <if test="name != null">
                        name,
                    </if>
                    <if test="createTime != null">
                        create_time,
                    </if>
                    <if test="updateTime != null">
                        update_time,
                    </if>
                    <if test="isDeleted != null">
                        is_deleted
                    </if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
                    <if test="id != null">
                        #{id},
                    </if>
                    <if test="name != null">
                        #{name},
                    </if>
                    <if test="createTime != null">
                        #{createTime},
                    </if>
                    <if test="updateTime != null">
                        #{updateTime},
                    </if>
                    <if test="isDeleted != null">
                        #{isDeleted}
                    </if>
        </trim>
    </insert>

    <!-- 更新数据（根据主键） -->
    <update id="update" parameterType="com.beat.mall.module.product.entity.Tag">
        UPDATE tag
        <set>
                        <if test="name != null">
                            name = #{name},
                        </if>
                        <if test="createTime != null">
                            create_time = #{createTime},
                        </if>
                        <if test="updateTime != null">
                            update_time = #{updateTime},
                        </if>
                        <if test="isDeleted != null">
                            is_deleted = #{isDeleted},
                        </if>
        </set>
        WHERE
                id = #{id}
    </update>

    <select id="extractByNames" resultType="com.beat.mall.module.product.entity.Tag" parameterType="java.util.List">
        select * from tag
        where name in
        <foreach collection="list" item="name" separator="," open="(" close=")">
           #{name}
        </foreach>
    </select>

    <select id="getByIds" resultType="com.beat.mall.module.product.entity.Tag" parameterType="java.util.List">
        select * from tag
        where id in
        <foreach collection="list" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
        and is_deleted = 0
    </select>

</mapper>